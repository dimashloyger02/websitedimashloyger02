<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE wml PUBLIC "-//WAPFORUM//DTD WML 1.1//EN"
 "http://www.wapforum.org/DTD/wml_1.1.xml">
<wml>
  <card id="main" title="Тест Скрипта">
    <p>
      Введите ваше имя:
      <!-- Текст сохранится в переменную user_name -->
      <input name="user_name" type="text"/>
    </p>

    <!-- Наша тестовая кнопка через do и go -->
    <do type="accept" label="Запустить">
      <go href="test.wmls#testFunction()"/>
    </do>

    <p>
      <!-- Сюда скрипт выведет ответ -->
      $(result_message)
    </p>
  </card>
</wml>
