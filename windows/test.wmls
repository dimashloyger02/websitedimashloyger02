extern function testFunction() {
    // 1. Получаем имя из WML-формы
    var name = WMLBrowser.getVar("user_name");
    
    // 2. Если пользователь ничего не ввел, пишем "Аноним"
    if (name == "") {
        name = "Аноним";
    }
    
    // 3. Формируем текст ответа
    var greeting = "Ура, скрипт работает! Привет, " + name;
    
    // 4. Записываем ответ обратно в переменную WML
    WMLBrowser.setVar("result_message", greeting);
    
    // 5. Обновляем экран, чтобы текст появился
    WMLBrowser.refresh();
}
